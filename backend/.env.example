# Copy this file to .env and fill in real values. Never commit .env.
FLASK_DEBUG=1
SECRET_KEY=change-me
# React dev server address (allowed by CORS, and where verify links redirect to)
FRONTEND_ORIGIN=http://localhost:5173
# Public address of this backend (used to build the email verification link)
BACKEND_URL=http://localhost:5001

# Local PostgreSQL database
# Mac (Homebrew, no password):
DATABASE_URL=postgresql+psycopg://localhost:5432/campus_carpool
# Windows (installer, user "postgres" + the password you chose):
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/campus_carpool

# Comma-separated list of school email domains allowed to sign up
ALLOWED_EMAIL_DOMAINS=uwo.ca
