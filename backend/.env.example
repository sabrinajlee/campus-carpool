# Copy this file to .env and fill in real values. Never commit .env.
FLASK_DEBUG=1
SECRET_KEY=change-me
# React dev server address (allowed by CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Local PostgreSQL database
# Mac (Homebrew, no password):
DATABASE_URL=postgresql+psycopg://localhost:5432/campus_carpool
# Windows (installer, user "postgres" + the password you chose):
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/campus_carpool
